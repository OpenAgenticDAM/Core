# Copy via scripts/init-env.sh (generates random secrets). No default credentials on purpose.
POSTGRES_USER=oad
POSTGRES_PASSWORD=
POSTGRES_DB=oad

OAD_S3_ACCESS_KEY=
OAD_S3_SECRET_KEY=
OAD_S3_BUCKET=oad-assets

# Ollama runs natively on the host.
OAD_OLLAMA_URL=http://host.docker.internal:11434
OAD_EMBED_MODEL=nomic-embed-text
OAD_EMBED_DIM=768

# Development identity (no OAuth yet). Empty principals = fail closed, sees nothing.
OAD_DEV_ACTOR=dev@localhost
OAD_DEV_PRINCIPALS=group:everyone

# HTTP transport (LibreChat & other network clients): required, >= 32 chars.
# scripts/init-env.sh generates it. Clients send "Authorization: Bearer <token>".
OAD_API_TOKEN=
# Host headers the HTTP transport accepts (DNS-rebinding protection)
# OAD_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,host.docker.internal:*

# Optional host port overrides
# OAD_POSTGRES_PORT=5433
# OAD_VALKEY_PORT=6379
# OAD_S3_PORT=8333
# OAD_GATEWAY_PORT=8000

# Pre-signed URLs are signed for this endpoint (host-side MCP clients)
OAD_S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
OAD_DEV_TENANT=00000000-0000-0000-0000-000000000001
